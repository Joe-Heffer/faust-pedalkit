// Designer Dry Wet: generated by the Pedal Kit effect designer from a block diagram.
// Every value below was chosen in the designer. To make this a new effect,
// follow AGENTS.md: notes, tests and docs are still needed.
//
// Signal flow (mono), in processing order:
//
//   x: the input
//   waveshaper1: Waveshaper (Asymmetric tanh) <- input, 4x oversampled, +32 samples
//   mix1: Mix <- input delayed 32, waveshaper1
//   output <- mix1, then the safety limiter
//
// Latency: 32 samples.

declare name        "Designer Dry Wet";
declare description "A waveshaper on one path, blended with the dry signal";
declare author      "Joe Heffer";
declare license     "MIT";
declare version     "0.1.0";
declare lv2class    "DistortionPlugin";

import("stdfaust.lib");
pk = library("pedalkit.lib");

// Fixed values.
waveshaper1Pos = 0.0; // dB, chosen in the designer
waveshaper1Neg = 0.0; // dB, chosen in the designer

// Controls, in the order they were exposed.
waveshaper1Drive = hslider("[0]Drive [unit:dB] [tooltip:Gain into the shaper]",
    0.0, 0.0, 40.0, 0.1) : si.smoo;
mix1Balance = hslider("[1]Blend Balance [unit:%] [tooltip:0 = A only, 100 = B only]",
    50.0, 0.0, 100.0, 0.1) : si.smoo;

// One named signal per block.
effect(x) = y with {
    waveshaper1 = x : pk.oversample4(*(ba.db2linear(waveshaper1Drive)) : pk.asymTanh(ba.db2linear(waveshaper1Pos), ba.db2linear(waveshaper1Neg)));
    mix1 = (x : @(pk.os4Latency)) * (1 - (mix1Balance / 100)) + waveshaper1 * (mix1Balance / 100);
    y = mix1;
};

// Reports the oversamplers' delay to the host, which can then compensate it.
latencySamples = pk.os4Latency;
latency = latencySamples
        : hbargraph("Latency [unit:samples] [lv2:reportsLatency] [lv2:integer]", 0, 256);

process = effect : pk.safety(0.989) : attach(_, latency);
