// Designer Chain: generated by the Pedal Kit effect designer from a block diagram.
// Every value below was chosen in the designer. To make this a new effect,
// follow AGENTS.md: notes, tests and docs are still needed.
//
// Signal flow (mono), in processing order:
//
//   x: the input
//   gain1: Gain <- input
//   waveshaper1: Waveshaper (Soft (symmetric tanh)) <- gain1, 4x oversampled, +32 samples
//   filter1: Filter (Low-pass, 2nd order) <- waveshaper1
//   output <- filter1, then the safety limiter
//
// Latency: 32 samples.

declare name        "Designer Chain";
declare description "Gain, waveshaper and low-pass in series";
declare author      "Joe Heffer";
declare license     "MIT";
declare version     "0.1.0";
declare lv2class    "DistortionPlugin";

import("stdfaust.lib");
pk = library("pedalkit.lib");

// Fixed values.
gain1Gain = 6.0; // dB, chosen in the designer
waveshaper1Ceiling = -3.0; // dB, chosen in the designer

// Controls, in the order they were exposed.
waveshaper1Drive = hslider("[0]Drive [unit:dB] [tooltip:Gain into the shaper]",
    18.0, 0.0, 40.0, 0.1) : si.smoo;
filter1Freq = hslider("[1]Tone Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    3000.0, 20.0, 20000.0, 1.0) : si.smoo;

// One named signal per block.
effect(x) = y with {
    gain1 = x : *(ba.db2linear(gain1Gain));
    waveshaper1 = gain1 : pk.oversample4(*(ba.db2linear(waveshaper1Drive)) : pk.softSat(ba.db2linear(waveshaper1Ceiling)));
    filter1 = waveshaper1 : fi.lowpass(2, filter1Freq);
    y = filter1;
};

// Reports the oversamplers' delay to the host, which can then compensate it.
latencySamples = pk.os4Latency;
latency = latencySamples
        : hbargraph("Latency [unit:samples] [lv2:reportsLatency] [lv2:integer]", 0, 256);

process = effect : pk.safety(0.989) : attach(_, latency);
