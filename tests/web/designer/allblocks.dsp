// SPDX-FileCopyrightText: 2026 Joe Heffer
// SPDX-License-Identifier: MIT
// Designer All Blocks: generated by the Pedal Kit effect designer from a block diagram.
// Every value below was chosen in the designer. To make this a new effect,
// follow AGENTS.md: notes, tests and docs are still needed.
//
// Signal flow (mono), in processing order:
//
//   x: the input
//   dcblock1: DC blocker <- input
//   gain1: Gain <- dcblock1
//   waveshaper1: Waveshaper (Soft (symmetric tanh)) <- gain1, 4x oversampled, +32 samples
//   filter1: Filter (High-pass, 1st order) <- waveshaper1
//   waveshaper2: Waveshaper (Knee clipper) <- filter1, 4x oversampled, +32 samples
//   filter2: Filter (Low-pass, 2nd order) <- waveshaper2
//   waveshaper3: Waveshaper (Asymmetric tanh) <- gain1, 4x oversampled, +32 samples
//   filter3: Filter (Peaking EQ) <- waveshaper3
//   mix1: Mix <- filter2, filter3 delayed 32
//   filter4: Filter (Low-pass, 1st order) <- gain1
//   filter5: Filter (High-pass, 2nd order) <- filter4
//   mix2: Mix <- mix1, filter5 delayed 64
//   waveshaper4: Waveshaper (Soft above, hard below) <- mix2, 4x oversampled, +32 samples
//   output <- waveshaper4, then the safety limiter
//
// Latency: 96 samples.

declare name        "Designer All Blocks";
declare description "Every block and variant, every parameter exposed";
declare author      "Joe Heffer";
declare license     "MIT";
declare version     "0.1.0";
declare lv2class    "DistortionPlugin";

import("stdfaust.lib");
pk = library("pedalkit.lib");

// Controls, in the order they were exposed.
gain1Gain = hslider("[0]Gain 1 [unit:dB] [tooltip:Level change]",
    0.0, -24.0, 24.0, 0.1) : si.smoo;
waveshaper1Drive = hslider("[1]Waveshaper 1 Drive [unit:dB] [tooltip:Gain into the shaper]",
    12.0, 0.0, 40.0, 0.1) : si.smoo;
waveshaper1Ceiling = hslider("[2]Waveshaper 1 Ceiling [unit:dB] [tooltip:Level the output approaches]",
    -3.0, -24.0, 0.0, 0.1) : si.smoo;
filter1Freq = hslider("[3]Filter 1 Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    80.0, 20.0, 20000.0, 1.0) : si.smoo;
waveshaper2Drive = hslider("[4]Waveshaper 2 Drive [unit:dB] [tooltip:Gain into the shaper]",
    6.0, 0.0, 40.0, 0.1) : si.smoo;
waveshaper2Ceiling = hslider("[5]Waveshaper 2 Ceiling [unit:dB] [tooltip:Level the output limits at]",
    -3.0, -24.0, 0.0, 0.1) : si.smoo;
waveshaper2Hardness = hslider("[6]Waveshaper 2 Hardness [unit:%] [tooltip:0 = soft knee, 100 = hard clip]",
    30.0, 0.0, 100.0, 1.0) : si.smoo;
filter2Freq = hslider("[7]Filter 2 Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    4000.0, 20.0, 20000.0, 1.0) : si.smoo;
waveshaper3Drive = hslider("[8]Waveshaper 3 Drive [unit:dB] [tooltip:Gain into the shaper]",
    12.0, 0.0, 40.0, 0.1) : si.smoo;
waveshaper3Pos = hslider("[9]Waveshaper 3 Positive ceiling [unit:dB] [tooltip:Level positive peaks approach]",
    -3.0, -24.0, 0.0, 0.1) : si.smoo;
waveshaper3Neg = hslider("[10]Waveshaper 3 Negative ceiling [unit:dB] [tooltip:Level negative peaks approach]",
    -6.0, -24.0, 0.0, 0.1) : si.smoo;
filter3Freq = hslider("[11]Filter 3 Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    800.0, 20.0, 20000.0, 1.0) : si.smoo;
filter3Gain = hslider("[12]Filter 3 Gain [unit:dB] [tooltip:Boost or cut at the centre]",
    6.0, -18.0, 18.0, 0.1) : si.smoo;
filter3Width = hslider("[13]Filter 3 Width [unit:oct] [tooltip:Bandwidth in octaves]",
    1.0, 0.1, 4.0, 0.01) : si.smoo;
mix1Balance = hslider("[14]Mix 1 Balance [unit:%] [tooltip:0 = A only, 100 = B only]",
    50.0, 0.0, 100.0, 0.1) : si.smoo;
filter4Freq = hslider("[15]Filter 4 Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    400.0, 20.0, 20000.0, 1.0) : si.smoo;
filter5Freq = hslider("[16]Filter 5 Frequency [unit:Hz] [scale:log] [tooltip:Corner or centre frequency]",
    40.0, 20.0, 20000.0, 1.0) : si.smoo;
mix2Balance = hslider("[17]Mix 2 Balance [unit:%] [tooltip:0 = A only, 100 = B only]",
    30.0, 0.0, 100.0, 0.1) : si.smoo;
waveshaper4Drive = hslider("[18]Waveshaper 4 Drive [unit:dB] [tooltip:Gain into the shaper]",
    3.0, 0.0, 40.0, 0.1) : si.smoo;
waveshaper4Pos = hslider("[19]Waveshaper 4 Positive ceiling [unit:dB] [tooltip:Level positive peaks approach]",
    -1.0, -24.0, 0.0, 0.1) : si.smoo;
waveshaper4Neg = hslider("[20]Waveshaper 4 Negative ceiling [unit:dB] [tooltip:Level negative peaks limit at]",
    -3.0, -24.0, 0.0, 0.1) : si.smoo;
waveshaper4Hardness = hslider("[21]Waveshaper 4 Hardness [unit:%] [tooltip:0 = soft knee, 100 = hard clip]",
    50.0, 0.0, 100.0, 1.0) : si.smoo;

// One named signal per block.
effect(x) = y with {
    dcblock1 = x : fi.dcblockerat(5);
    gain1 = dcblock1 : *(ba.db2linear(gain1Gain));
    waveshaper1 = gain1 : pk.oversample4(*(ba.db2linear(waveshaper1Drive)) : pk.softSat(ba.db2linear(waveshaper1Ceiling)));
    filter1 = waveshaper1 : fi.highpass(1, filter1Freq);
    waveshaper2 = filter1 : pk.oversample4(*(ba.db2linear(waveshaper2Drive)) : pk.kneeClip(ba.db2linear(waveshaper2Ceiling), (1 + 9 * (waveshaper2Hardness) / 100)));
    filter2 = waveshaper2 : fi.lowpass(2, filter2Freq);
    waveshaper3 = gain1 : pk.oversample4(*(ba.db2linear(waveshaper3Drive)) : pk.asymTanh(ba.db2linear(waveshaper3Pos), ba.db2linear(waveshaper3Neg)));
    filter3 = waveshaper3 : fi.peak_eq_cq(filter3Gain, filter3Freq, (sqrt(2 ^ (filter3Width)) / (2 ^ (filter3Width) - 1)));
    mix1 = filter2 * (1 - (mix1Balance / 100)) + (filter3 : @(pk.os4Latency)) * (mix1Balance / 100);
    filter4 = gain1 : fi.lowpass(1, filter4Freq);
    filter5 = filter4 : fi.highpass(2, filter5Freq);
    mix2 = mix1 * (1 - (mix2Balance / 100)) + (filter5 : @(2 * pk.os4Latency)) * (mix2Balance / 100);
    waveshaper4 = mix2 : pk.oversample4(*(ba.db2linear(waveshaper4Drive)) : pk.asymSoftHard(ba.db2linear(waveshaper4Pos), ba.db2linear(waveshaper4Neg), (1 + 9 * (waveshaper4Hardness) / 100)));
    y = waveshaper4;
};

// Reports the oversamplers' delay to the host, which can then compensate it.
latencySamples = 3 * pk.os4Latency;
latency = latencySamples
        : hbargraph("Latency [unit:samples] [lv2:reportsLatency] [lv2:integer]", 0, 256);

process = effect : pk.safety(0.989) : attach(_, latency);
