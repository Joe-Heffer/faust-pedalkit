  (global_label "VB" (shape input) (at 76.2 119.38 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "30d0c4ca-a2c1-5111-b4ca-8530a7ebfdad") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 76.2 119.38 0) (effects (font (size 1.27 1.27)) hide)))
