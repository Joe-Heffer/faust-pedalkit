  (global_label "VB" (shape input) (at 78.74 96.52 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "d94f516a-5d0f-5848-9e46-ce9351c22c37") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 78.74 96.52 0) (effects (font (size 1.27 1.27)) hide)))
  (hierarchical_label "OUT" (shape output) (at 124.46 83.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "27bc8800-fcac-5c40-abcd-e0329fc0c44f"))
  (text "Bite 100: 40 Hz, Q 0.71; Bite 0: 9.98 Hz\nRVX1, RVX2: two gangs of one pot, shown at Bite 100;\neach is 4 times larger at Bite 0 (225k, 113k)" (exclude_from_sim no) (at 40.64 116.84 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e225b913-197a-5483-a708-985700f9095a"))
  (text "Section 4 of the circuit notes, stage 3. The pedal's Bite switch adds a subsonic filter [1]; its circuit is not public.\nA unity-gain Sallen-Key Butterworth high-pass (all chosen) whose resistors are two gangs of the Bite pot, so the corner\nglides from 10 Hz (Bite 0, out of the way) to 40 Hz (Bite 100, just below low E) at a constant Q, as biteHpLo and biteHpHi\ndo in the DSP. A switch and fixed resistors would give the pedal's two settings." (exclude_from_sim no) (at 25.4 198.12 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a63f5d68-e837-5534-aa34-059d419e2b37"))
